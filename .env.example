# ============================================================
# ResearchMate — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# .env is already excluded by .gitignore.
# ============================================================

# ── Required ──────────────────────────────────────────────
# Groq API key for LLM access.
# Get your key at: https://console.groq.com/keys
# BYOK: bring your own key. Free quota available on Groq.
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Redis ─────────────────────────────────────────────────
# Local development (default if not set):
REDIS_URI=redis://localhost:6379

# Managed Redis — Upstash (free tier candidate):
# Upstash requires TLS. Use rediss:// scheme.
# Get your URL from: https://console.upstash.com
# Cost note: Upstash free tier has a daily command limit.
#   Exceeding it may incur charges. Review quotas before
#   enabling in production.
# REDIS_URI=rediss://:your_upstash_password@your-endpoint.upstash.io:6379

# ── PostgreSQL / Supabase ─────────────────────────────────
# Not required for local Redis-only operation.
# Leave empty to run without PostgreSQL.
#
# Local PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/researchmate
#
# Supabase PostgreSQL — direct connection (use for migrations and local dev):
# DATABASE_URL=postgresql+asyncpg://postgres:your_db_password@db.your_project_ref.supabase.co:5432/postgres
#
# Supabase PostgreSQL — pooled connection (use for application connections in production):
# DATABASE_URL=postgresql+asyncpg://postgres:your_db_password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# Cost note: Supabase free tier pauses projects after 1 week of inactivity.
#   Paid plans are required for always-on production databases
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres

# ── Application ───────────────────────────────────────────
# Runtime environment label. Values: local | staging | production
APP_ENV=local


# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Default covers the Vite dev server and preview server.
# In production, set this to your actual deployed frontend URL.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Storage paths (optional overrides) ───────────────────
# Absolute or relative paths. Relative paths are resolved
# from the project root directory.
#
# Directory where .txt research reports are saved locally.
# ⚠ Cloud Run warning: container filesystems are ephemeral.
#   Reports saved here will NOT survive container restarts or
#   redeployments. Persistent cloud object storage must be
#   implemented before reliable report downloads in the cloud.
# REPORTS_DIR=reports

# Directory where the Chroma local vector store is persisted.
# CHROMA_PERSIST_DIR=RAG/vectorstore
